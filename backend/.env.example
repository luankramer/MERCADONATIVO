# ============================================================
#  Mercado Nativo — configurações do backend
#  Copie este arquivo para ".env" e ajuste os valores.
#  NUNCA envie o .env para o GitHub (ele já está no .gitignore).
# ============================================================

# dev = desenvolvimento | producao = desliga /docs e endurece o sistema
APP_ENV=dev

# --- Banco de dados (MySQL) ---
# No Railway: DATABASE_URL=${{MySQL.MYSQL_URL}} (o prefixo mysql:// é convertido sozinho)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/mercado_nativo

# --- Fotos enviadas ---
# Vazio = backend/uploads. No Railway: /data/uploads, com um volume montado em /data
UPLOAD_DIR=

# --- Segurança ---
# Texto aleatório com 40+ caracteres. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# (opcional) chave própria para criptografar os tokens do Mercado Pago no banco
ENCRYPTION_KEY=
PRODUCER_TOKEN_HOURS=168
ADMIN_TOKEN_HOURS=8
# Endereços do site que podem chamar a API (o IP da rede local já é liberado automaticamente)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Administração ---
# Este e-mail é o Super Admin. Defina a senha com:  redefinir_admin.bat
ADMIN_MASTER_EMAIL=seu-email@exemplo.com
# WhatsApp do Super Admin (só números, com DDD) para receber o código de "Esqueci minha senha".
# Os outros admins cadastram o WhatsApp em Gestão de Administradores.
ADMIN_MASTER_WHATSAPP=
# Servidor novo (Railway): cria o Super Admin com esta senha se ainda não houver nenhum administrador.
# Mínimo 8 caracteres. Apague a variável depois do primeiro acesso.
ADMIN_INICIAL_SENHA=
# true = cadastra os produtores e produtos de demonstração se o banco estiver sem produtos
DADOS_DEMO=false

# --- WhatsApp (Evolution API) ---
EVOLUTION_BASE_URL=http://SEU_SERVIDOR:PORTA
EVOLUTION_TOKEN=SEU_TOKEN
EVOLUTION_INSTANCE=mercadonativo
# true = se o WhatsApp falhar, o código de login aparece SÓ nesta janela do backend
# (em produção deixe false: nunca mostre códigos no terminal)
OTP_DEV_MODE=true

# --- WhatsApp de reserva (opcional, recomendado): API oficial do WhatsApp (Meta Cloud API) ---
# Usado automaticamente quando a Evolution API não responde. Crie em developers.facebook.com > WhatsApp.
# META_WA_PHONE_ID = "Identificação do número de telefone"; META_WA_TOKEN = token permanente (usuário do sistema)
META_WA_TOKEN=
META_WA_PHONE_ID=
# Modelo de mensagem da categoria "Autenticação" aprovado pela Meta (com botão "Copiar código").
# Sem modelo, a Meta só entrega texto livre para quem falou com o número nas últimas 24 h.
META_WA_TEMPLATE_CODIGO=
META_WA_IDIOMA=pt_BR

# --- E-mail de reserva para o código de login (opcional) ---
# Se o WhatsApp falhar, o produtor pode receber o código no e-mail cadastrado no perfil.
# Porta 465 = SSL; 587 = STARTTLS. Ex.: smtp.gmail.com com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# --- Pagamentos ---
# simulado    = demonstração, não cobra nada (ideal para a banca). NÃO funciona com APP_ENV=producao:
#               em produção o checkout fica desativado em vez de "aprovar" pagamentos de mentira.
# mercadopago = crédito, débito e Pix de verdade (exige MP_ACCESS_TOKEN e MP_PUBLIC_KEY; sem elas = desativado)
PAYMENT_MODE=simulado

# Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de teste (TEST-...) ou de produção (APP_USR-...)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Split automático (opcional): mesma tela, "Client ID" e "Client Secret" + URL de redirecionamento cadastrada
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://SEU-ENDERECO-HTTPS/api/v1/mercadopago/callback
# Endereço HTTPS público do backend (ngrok) — usado no webhook de confirmação do Pix
PUBLIC_API_URL=
# Mercado Pago > Webhooks > "Assinatura secreta"  (OBRIGATÓRIA em produção: sem ela, avisos falsos são aceitos
# só para disparar consulta; com ela, avisos sem assinatura válida são recusados)
MP_WEBHOOK_SECRET=

# --- Resiliência do Mercado Pago ---
# Cada chamada espera até MP_TIMEOUT segundos e tenta de novo MP_TENTATIVAS vezes (com a mesma chave de
# idempotência, então nunca cobra duas vezes). Depois de MP_FALHAS_PARA_PAUSAR falhas seguidas, o sistema
# "pausa" o Mercado Pago por MP_PAUSA_SEGUNDOS: as páginas não travam e o Pix de reserva é oferecido.
MP_TIMEOUT=12
MP_TENTATIVAS=2
MP_FALHAS_PARA_PAUSAR=3
MP_PAUSA_SEGUNDOS=60

# --- Pix de reserva (quando o Mercado Pago cai ou está desativado) ---
# Chave Pix da conta do Mercado Nativo. O cliente paga um Pix Copia e Cola com o valor exato e a
# identificação MN<nº do pedido>; a equipe confere no extrato e clica "Confirmar Pix recebido" no painel.
# Nome: até 25 letras; cidade: até 15 letras (sem acentos é mais seguro).
PIX_RESERVA_CHAVE=
PIX_RESERVA_NOME=MERCADO NATIVO
PIX_RESERVA_CIDADE=RIO BRANCO

# --- Tarefas automáticas (rodam dentro do backend) ---
# A cada TAREFAS_INTERVALO segundos: reprocessa avisos do Mercado Pago que falharam, confere Pix pendentes,
# recupera pagamentos cuja resposta se perdeu, acompanha devoluções e reenvia mensagens de WhatsApp na fila.
# Com mais de um processo (vários workers), deixe true em só um deles ou rode: python -m app.services.tarefas_service
TAREFAS_AUTOMATICAS=true
TAREFAS_INTERVALO=120

PLATFORM_FEE_PERCENT=10

# Versão dos Termos de Uso / Política de Privacidade. Ao mudar os textos (front-mercado/src/content/politicas.ts),
# aumente aqui também: o painel pede para os vendedores aceitarem a nova versão.
TERMOS_VERSAO=1.2
PREMIUM_PRICE=9.90
PREMIUM_DAYS=30
