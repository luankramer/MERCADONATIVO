# ============================================================
#  Mercado Nativo — configurações do backend
#  Copie este arquivo para ".env" e ajuste os valores.
#  NUNCA envie o .env para o GitHub (ele já está no .gitignore).
# ============================================================

# dev = desenvolvimento | producao = desliga /docs e endurece o sistema
APP_ENV=dev

# --- Banco de dados (MySQL) ---
DATABASE_URL=mysql+pymysql://root:@localhost:3306/mercado_nativo

# --- Segurança ---
# Texto aleatório com 40+ caracteres. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# (opcional) chave própria para criptografar os tokens do Mercado Pago no banco
ENCRYPTION_KEY=
PRODUCER_TOKEN_HOURS=168
ADMIN_TOKEN_HOURS=8
# Endereços do site que podem chamar a API (o IP da rede local já é liberado automaticamente)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Administração ---
# Este e-mail é o Super Admin. Defina a senha com:  redefinir_admin.bat
ADMIN_MASTER_EMAIL=seu-email@exemplo.com

# --- WhatsApp (Evolution API) ---
EVOLUTION_BASE_URL=http://SEU_SERVIDOR:PORTA
EVOLUTION_TOKEN=SEU_TOKEN
EVOLUTION_INSTANCE=mercadonativo
# true = se o WhatsApp falhar, o código de login aparece SÓ nesta janela do backend
OTP_DEV_MODE=true

# --- Assistente de texto ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Pagamentos ---
# simulado    = demonstração, não cobra nada (ideal para a banca)
# mercadopago = crédito, débito e Pix de verdade
PAYMENT_MODE=simulado

# Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de teste (TEST-...) ou de produção (APP_USR-...)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Split automático (opcional): mesma tela, "Client ID" e "Client Secret" + URL de redirecionamento cadastrada
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://SEU-ENDERECO-HTTPS/api/v1/mercadopago/callback
# Endereço HTTPS público do backend (ngrok) — usado no webhook de confirmação do Pix
PUBLIC_API_URL=
# Mercado Pago > Webhooks > "Assinatura secreta"
MP_WEBHOOK_SECRET=

PLATFORM_FEE_PERCENT=10

# Versão dos Termos de Uso / Política de Privacidade. Ao mudar os textos (front-mercado/src/content/politicas.ts),
# aumente aqui também: o painel pede para os vendedores aceitarem a nova versão.
TERMOS_VERSAO=1.0
PREMIUM_PRICE=9.90
PREMIUM_DAYS=30
